<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo de la Home (detrás de los íconos). Sin fondo elegido queda transparente y se ve el del sistema -->
    <com.alouncher.app.BackdropView
        android:id="@+id/home_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============ HOME ============ -->
    <FrameLayout
        android:id="@+id/home_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Páginas deslizables de la Home (cada página es una cuadrícula) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/home_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="64dp"
            android:alpha="0.8"
            android:gravity="center"
            android:maxWidth="360dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/home_vacia"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Indicador de páginas: justo encima del dock -->
        <com.alouncher.app.PageIndicator
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="108dp" />

        <com.alouncher.app.CappedLinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/dock_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp" />

        <!-- Papelera: solo aparece al arrastrar un ícono ya colocado; soltarlo aquí lo quita -->
        <ImageView
            android:id="@+id/home_trash"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/trash_bg"
            android:contentDescription="@string/quitar_home"
            android:scaleType="center"
            android:src="@drawable/ic_trash"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- ============ MODO EDICIÓN (mantener pulsado un espacio vacío) ============ -->
    <FrameLayout
        android:id="@+id/edit_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="88dp">

                <TextView
                    android:id="@+id/edit_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="160dp"
                    android:gravity="center"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="@string/editar_ayuda"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/edit_trash"
                    android:layout_width="72dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/trash_bg"
                    android:contentDescription="@string/eliminar_pagina"
                    android:scaleType="center"
                    android:src="@drawable/ic_trash"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/edit_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="56dp"
                    android:background="@drawable/btn_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/listo"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/edit_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/edit_add_left"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_ghost"
                    android:clickable="true"
                    android:contentDescription="@string/pagina_izquierda"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/ic_plus" />

                <com.alouncher.app.PageIndicator
                    android:id="@+id/edit_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp" />

                <ImageView
                    android:id="@+id/edit_add_right"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_ghost"
                    android:clickable="true"
                    android:contentDescription="@string/pagina_derecha"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/ic_plus" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal|top"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/edit_action_themes"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_bg"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_roller" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/fondos_temas"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/edit_action_widgets"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_bg"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_widgets" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/widgets"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/edit_action_config"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_bg"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_gear" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/config_home"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ CAJÓN DE APPS (sube sobre la Home) ============ -->
    <FrameLayout
        android:id="@+id/drawer_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim"
            android:clickable="true" />

        <com.alouncher.app.DrawerSheet
            android:id="@+id/drawer_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="80dp"
            android:background="@drawable/drawer_bg"
            android:orientation="vertical"
>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Fondo del cajón (detrás de los íconos) -->
                <com.alouncher.app.BackdropView
                    android:id="@+id/drawer_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="10dp">


            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/grip_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/drawer_title"
                    android:fontFamily="serif"
                    android:text="@string/todas_las_apps"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawer_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingHorizontal="18dp"
                    android:text="@string/cerrar"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:paddingTop="8dp"
                android:scrollbars="none" />
        
                </LinearLayout>
            </FrameLayout>
        </com.alouncher.app.DrawerSheet>
    </FrameLayout>
</FrameLayout>
